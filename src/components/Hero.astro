---
import { Image } from 'astro:assets';
import budyCalma from '../assets/budy/budy-calma.png';
import { beneficios } from '../data/sitio';
import { url } from '../lib/url';

// Forma inicial del círculo (sin JS se queda así): círculo perfecto en viewBox 400×400.
const R = 168;
const circulo = `M${200 + R},200 A${R},${R} 0 1,1 ${200 - R},200 A${R},${R} 0 1,1 ${200 + R},200 Z`;
const frase = beneficios.map((b) => b.toLocaleLowerCase('es-ES')).join(', ');
const nube = 'M20 44 C7 44 4 29 16 26 C14 13 31 8 39 17 C44 4 67 4 71 18 C80 10 97 15 95 28 C108 28 110 44 96 44 Z';
---
<section class="hero" id="inicio" aria-labelledby="hero-titulo">
  <div class="container hero-cuerpo">
    <p class="hero-ante">Escuela de Mindfulness</p>
    <h1 id="hero-titulo" class="hero-titulo">Aprende a vivir con…</h1>
    <p class="sr-only">{frase}.</p>
    <p class="rotador" aria-hidden="true" data-rotador>
      {beneficios.map((b, i) => <span class:list={['rotador-palabra', { 'es-activa': i === 0 }]}>{b}</span>)}
    </p>
    <p class="hero-sub">Sesiones de mindfulness en directo por videoconferencia, con acompañamiento personal.</p>
    <div class="hero-acciones">
      <a href={url('consultame/#solicita')} class="btn btn--blanco btn--grande" data-abrir-sesiones>Empieza ahora</a>
      <a href="#como-es" class="btn btn--linea-blanca btn--grande">+ Info</a>
    </div>

    <div class="hero-visual" data-respira>
      <svg class="respira-svg" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
        <path class="respira-halo" d={circulo} data-halo />
        <path class="respira-blob" d={circulo} data-blob />
      </svg>
      <Image
        src={budyCalma}
        alt="Budy, la mascota de la escuela, medita sereno entre árboles y se imagina meditando"
        widths={[280, 400, 560, 800]}
        sizes="(min-width: 1024px) 340px, (min-width: 640px) 300px, 58vw"
        loading="eager"
        fetchpriority="high"
        class="budy"
      />
      <p class="respira-guia" aria-hidden="true" data-guia>
        <span data-fase="inspira">Inspira</span><span data-fase="espira">Espira</span>
      </p>
      <button type="button" class="pausa" aria-pressed="false" data-pausa>
        <span class="sr-only" data-pausa-texto>Pausar la animación</span>
        <svg class="pausa-icono-pausa" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="2.5" width="3" height="11" rx="1.2" /><rect x="9.5" y="2.5" width="3" height="11" rx="1.2" /></svg>
        <svg class="pausa-icono-play" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.8v10.4a.8.8 0 0 0 1.2.7l8.3-5.2a.8.8 0 0 0 0-1.4L5.7 2.1a.8.8 0 0 0-1.2.7z" /></svg>
      </button>
    </div>
  </div>

  <div class="nubes" aria-hidden="true">
    <svg class="nube nube--1" viewBox="0 0 112 50" data-paralaje="0.25"><path pathLength="1" d={nube} /></svg>
    <svg class="nube nube--2" viewBox="0 0 112 50" data-paralaje="0.4"><path pathLength="1" d={nube} /></svg>
    <svg class="nube nube--3" viewBox="0 0 112 50" data-paralaje="0.15"><path pathLength="1" d={nube} /></svg>
  </div>
  <svg class="ola" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 40 C 240 0 480 0 720 30 S 1200 70 1440 30 V70 H0Z" fill="var(--cielo)" /></svg>
</section>

<style>
  .hero {
    position: relative;
    /* Abajo deja sitio a la ola para que no tape la base de Budy */
    padding: calc(var(--cabecera) + var(--s-5)) 0 calc(clamp(36px, 5vw, 70px) - 14px);
    background: var(--fondo-turquesa);
    color: var(--blanco);
    overflow: clip;
  }
  .hero-cuerpo { position: relative; z-index: 2; display: grid; justify-items: center; text-align: center; }
  .hero-ante {
    font-size: var(--fs-sm); font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase;
    color: rgb(255 255 255 / 0.9);
    margin-bottom: var(--s-3);
  }
  .hero-titulo { font-size: clamp(2.1rem, 1.3rem + 3.6vw, 4.4rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  /* Todas las palabras ocupan la misma celda: el bloque mide lo que la más larga. */
  .rotador {
    display: grid; justify-items: center;
    margin-top: var(--s-1);
    font-size: clamp(2.5rem, 1.4rem + 4.6vw, 5.6rem);
    font-weight: 800; line-height: 1.04; letter-spacing: -0.025em;
    text-shadow: 0 4px 30px rgb(0 60 70 / 0.25);
  }
  .rotador-palabra { grid-area: 1 / 1; visibility: hidden; }
  .rotador-palabra.es-activa { visibility: visible; }
  .rotador-palabra :global(.palabra) { display: inline-block; white-space: nowrap; }
  .rotador-palabra :global(.letra) { display: inline-block; will-change: transform, opacity, filter; }
  .hero-sub { margin-top: var(--s-4); max-width: 36ch; font-size: var(--fs-md); line-height: 1.5; color: var(--blanco); }
  .hero-acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3); margin-top: var(--s-6); }

  /* --- Escena: Budy y los círculos que respiran --- */
  .hero-visual { position: relative; width: min(88vw, 520px); aspect-ratio: 1 / 0.86; margin-top: var(--s-6); }
  .respira-svg { position: absolute; left: 50%; bottom: -22%; width: 112%; height: auto; translate: -50% 0; overflow: visible; }
  .respira-blob { fill: rgb(255 255 255 / 0.16); }
  .respira-halo { fill: rgb(255 255 255 / 0.1); transform-origin: 200px 200px; transform: scale(1.12); }
  :global(.budy) {
    position: absolute; left: 50%; bottom: 0;
    width: 58%;
    transform: translateX(-50%);
    filter: drop-shadow(0 30px 40px rgb(0 50 60 / 0.35));
  }
  .respira-guia {
    position: absolute; left: 50%; top: 4%; translate: -50% 0;
    display: grid; justify-items: center;
    padding: 6px 16px; border-radius: var(--r-pill);
    background: rgb(0 60 70 / 0.3);
    font-size: var(--fs-xs); font-weight: 800; letter-spacing: 0.24em; text-transform: uppercase;
    visibility: hidden;
  }
  .respira-guia span { grid-area: 1 / 1; opacity: 0; transition: opacity 900ms var(--ease-respira); }
  :global(html.js) .hero-visual.esta-viva .respira-guia { visibility: visible; }
  .respira-guia span.es-activa { opacity: 1; }

  .pausa {
    position: absolute; right: 0; top: 2%;
    display: none; place-items: center;
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.45);
    background: rgb(0 60 70 / 0.25);
    color: var(--blanco);
    transition: background-color var(--t-rapida) var(--ease-suave);
  }
  .pausa:hover { background: rgb(0 60 70 / 0.45); }
  .pausa:focus-visible { outline-color: var(--blanco); }
  .pausa svg { fill: currentColor; }
  :global(html.js) .hero-visual.esta-viva .pausa { display: grid; }
  .pausa-icono-play, .pausa[aria-pressed='true'] .pausa-icono-pausa { display: none; }
  .pausa[aria-pressed='true'] .pausa-icono-play { display: block; }
  .hero :focus-visible { outline-color: var(--blanco); }

  /* Nubes blancas que se dibujan y derivan despacio */
  .nubes { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .nube { position: absolute; overflow: visible; filter: drop-shadow(0 8px 14px rgb(0 60 70 / 0.18)); }
  .nube path { fill: var(--blanco); stroke: var(--blanco); stroke-width: 2.2; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .nube--1 { top: 30%; left: 4%; width: 120px; }
  .nube--2 { top: 16%; right: 6%; width: 92px; }
  .nube--3 { top: 64%; right: 8%; width: 70px; }
  /* En móvil no caben sin tapar texto o botones */
  @media (max-width: 760px) {
    .nubes { display: none; }
    .respira-guia { left: 0; translate: 0 0; }
  }
  :global(html.js) .hero.esta-viva .nube path { animation: nube-trazo 1.6s var(--ease-respira) both; }
  :global(html.js) .hero.esta-viva .nube--2 path { animation-delay: 0.35s; }
  :global(html.js) .hero.esta-viva .nube--3 path { animation-delay: 0.7s; }
  :global(html.js) .hero.esta-viva .nube { animation: nube-deriva 22s var(--ease-respira) 1.6s infinite alternate; }
  :global(html.js) .hero.esta-viva .nube--2 { animation-duration: 28s; animation-direction: alternate-reverse; }
  :global(html.js) .hero.esta-viva .nube--3 { animation-duration: 25s; }
  :global(html.js) .hero.esta-pausada .nube { animation-play-state: paused; }
  @keyframes nube-trazo { 0% { stroke-dashoffset: 1; fill-opacity: 0; } 70% { fill-opacity: 0; } 100% { stroke-dashoffset: 0; fill-opacity: 1; } }
  @keyframes nube-deriva { from { translate: -14px 0; } to { translate: 18px 0; } }

  @media (min-width: 1024px) {
    .hero { padding-top: calc(var(--cabecera) + var(--s-6)); }
    .hero-visual { width: 560px; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const visual = document.querySelector<HTMLElement>('[data-respira]');
  const rotador = document.querySelector<HTMLElement>('[data-rotador]');

  if (visual && rotador && !reducido) {
    const blob = visual.querySelector<SVGPathElement>('[data-blob]')!;
    const halo = visual.querySelector<SVGPathElement>('[data-halo]')!;
    const fases = [...visual.querySelectorAll<HTMLElement>('[data-fase]')];
    const pausa = visual.querySelector<HTMLButtonElement>('[data-pausa]')!;
    const pausaTexto = visual.querySelector<HTMLElement>('[data-pausa-texto]')!;
    visual.classList.add('esta-viva');
    visual.closest('.hero')?.classList.add('esta-viva');

    // ---------- Círculo que respira ----------
    // Blob de 8 puntos con ruido suave (deformación ligera) y una escala
    // que sube en 4 s (inspira) y baja en 6 s (espira), en bucle.
    const N = 8, R = 168, AMP = 0.045;
    const INSPIRA = 4, ESPIRA = 6, CICLO = INSPIRA + ESPIRA;
    const MIN = 0.84, MAX = 1;
    const semillas = Array.from({ length: N }, (_, i) => i * 1.7 + Math.random() * 3);
    const suave = (x: number) => 0.5 - Math.cos(Math.PI * x) / 2; // sine.inOut

    function ruta(escala: number, t: number, r = R, fase = 0) {
      const p: [number, number][] = [];
      for (let i = 0; i < N; i++) {
        const a = (i / N) * Math.PI * 2;
        const ondula = Math.sin(t * 0.35 + semillas[i] + fase) * 0.6 + Math.sin(t * 0.21 + semillas[i] * 2.3) * 0.4;
        const rr = r * escala * (1 + AMP * ondula);
        p.push([200 + Math.cos(a) * rr, 200 + Math.sin(a) * rr]);
      }
      let d = `M${p[0][0].toFixed(1)},${p[0][1].toFixed(1)}`;
      for (let i = 0; i < N; i++) {
        const p0 = p[(i - 1 + N) % N], p1 = p[i], p2 = p[(i + 1) % N], p3 = p[(i + 2) % N];
        d += `C${(p1[0] + (p2[0] - p0[0]) / 6).toFixed(1)},${(p1[1] + (p2[1] - p0[1]) / 6).toFixed(1)} ${(p2[0] - (p3[0] - p1[0]) / 6).toFixed(1)},${(p2[1] - (p3[1] - p1[1]) / 6).toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
      }
      return d + 'Z';
    }

    let reloj = 0, ultimo = performance.now(), activo = true, pausado = false, faseActual = '';
    function marcaFase(f: string) {
      if (f === faseActual) return;
      faseActual = f;
      fases.forEach((s) => s.classList.toggle('es-activa', s.dataset.fase === f));
    }
    function cuadro(ahora: number) {
      const dt = Math.min(0.05, (ahora - ultimo) / 1000);
      ultimo = ahora;
      if (activo && !pausado) {
        reloj += dt;
        const c = reloj % CICLO;
        const k = c < INSPIRA ? suave(c / INSPIRA) : 1 - suave((c - INSPIRA) / ESPIRA);
        const escala = MIN + (MAX - MIN) * k;
        blob.setAttribute('d', ruta(escala, reloj));
        halo.setAttribute('d', ruta(MIN + (MAX - MIN) * Math.max(0, k - 0.06), reloj * 0.8, R * 1.13, 2));
        marcaFase(c < INSPIRA ? 'inspira' : 'espira');
      }
      requestAnimationFrame(cuadro);
    }
    halo.style.transform = 'none';
    requestAnimationFrame(cuadro);

    // Solo se anima mientras se ve
    new IntersectionObserver(([e]) => { activo = e.isIntersecting; }).observe(visual);

    // ---------- Titular rotativo ----------
    const palabras = [...rotador.querySelectorAll<HTMLElement>('.rotador-palabra')];
    palabras.forEach((p) => {
      const texto = p.textContent || '';
      p.textContent = '';
      // Letras agrupadas por palabra: la línea solo puede partirse entre palabras,
      // igual que antes de dividir, así el bloque no cambia de altura.
      texto.split(' ').forEach((pal, n) => {
        if (n) p.appendChild(document.createTextNode(' '));
        const w = document.createElement('span');
        w.className = 'palabra';
        [...pal].forEach((ch) => {
          const s = document.createElement('span');
          s.className = 'letra';
          s.textContent = ch;
          w.appendChild(s);
        });
        p.appendChild(w);
      });
    });
    const tl = gsap.timeline({ repeat: -1, delay: 2.5 });
    palabras.forEach((_, n) => {
      const sale = palabras[n], entra = palabras[(n + 1) % palabras.length];
      tl.to(sale.querySelectorAll('.letra'), { autoAlpha: 0, y: -8, filter: 'blur(6px)', duration: 0.45, ease: 'power2.in', stagger: 0.015 })
        .set(sale, { visibility: 'hidden' })
        .set(entra, { visibility: 'visible' })
        .fromTo(entra.querySelectorAll('.letra'),
          { autoAlpha: 0, y: 10, filter: 'blur(8px)' },
          { autoAlpha: 1, y: 0, filter: 'blur(0px)', duration: 0.7, ease: 'power2.out', stagger: 0.025 })
        .to({}, { duration: 1.35 });
    });
    new IntersectionObserver(([e]) => { if (!pausado) (e.isIntersecting ? tl.resume() : tl.pause()); }).observe(rotador);

    // ---------- Pausa (WCAG 2.2.2) ----------
    pausa.addEventListener('click', () => {
      pausado = !pausado;
      pausa.setAttribute('aria-pressed', String(pausado));
      pausaTexto.textContent = pausado ? 'Reanudar la animación' : 'Pausar la animación';
      visual.classList.toggle('esta-pausada', pausado);
      visual.closest('.hero')?.classList.toggle('esta-pausada', pausado);
      pausado ? tl.pause() : tl.resume();
    });
  }
</script>
