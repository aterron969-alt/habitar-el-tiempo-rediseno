---
// Portada · «¿Quieres recibir novedades?»: Budy + formulario de suscripción (demo).
import { Image } from 'astro:assets';
import Campo from './Campo.astro';
import AvisoDemo from './AvisoDemo.astro';
import budyMail from '../assets/orig/budy-mail-ancho.webp';
import { suscripcion } from '../data/portada';
import { externos } from '../data/sitio';
import '../styles/formularios.css';
---
<section class="seccion seccion--cielo suscripcion" id="novedades" aria-labelledby="sus-titulo">
  <div class="container">
    <div class="sus-caja" data-revelar>
      <div class="sus-visual">
        <Image src={budyMail} alt="Budy medita sobre una arroba entre nubes" widths={[260, 400, 520]} sizes="(min-width: 900px) 320px, 220px" class="sus-budy" />
      </div>
      <div class="sus-form">
        <h2 id="sus-titulo" class="h2">{suscripcion.titulo}</h2>
        <p class="lead">{suscripcion.sub}</p>
        <!-- PENDIENTE: conectar con el servicio de newsletter de la escuela
             (action="..." method="POST" y quitar data-demo). -->
        <form class="formulario" novalidate data-demo>
          <div class="formulario-fila formulario-fila--2">
            <Campo id="sus-nombre" nombre="nombre" etiqueta="Nombre" requerido autocomplete="given-name" vacio="Escribe tu nombre." />
            <Campo id="sus-email" nombre="email" etiqueta="Correo electrónico" tipo="email" requerido autocomplete="email" vacio="Escribe tu correo electrónico." />
          </div>
          <Campo id="sus-acepto" nombre="consentimiento" tipo="checkbox" requerido vacio="Necesitamos que aceptes la política de privacidad.">
            He leído y acepto la <a href={externos.privacidad} rel="noopener" target="_blank">política de privacidad</a>
          </Campo>
          <button type="submit" class="btn btn--primario btn--grande">Suscribirme ›</button>
          <AvisoDemo />
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .sus-caja {
    display: grid; gap: var(--s-5);
    padding: var(--s-6) var(--s-5);
    border-radius: var(--r-lg);
    background: var(--blanco);
    box-shadow: var(--sombra-2);
    max-width: 980px;
    margin-inline: auto;
  }
  .sus-visual { display: grid; place-items: center; }
  :global(.sus-budy) { width: min(220px, 60vw); height: auto; }
  .sus-form .lead { margin: var(--s-2) 0 var(--s-5); }
  .sus-form .btn { justify-self: start; }
  @media (min-width: 900px) {
    .sus-caja { grid-template-columns: 320px 1fr; gap: var(--s-7); padding: var(--s-7); align-items: center; }
    :global(.sus-budy) { width: 300px; }
  }
</style>
