---
// Portada · «Sesiones en directo · Mindfulness online» (ancla #sesiones del menú).
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import ilustracion from '../assets/orig/sesiones-individuales.webp';
import { sesiones } from '../data/portada';
import { url } from '../lib/url';
// «8.000» con punto de millar (toLocaleString('es-ES') no lo pone en cifras de 4 dígitos).
const fmt = (n: number, anio?: boolean) => (anio ? String(n) : String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.'));
---
<section class="seccion sesiones" id="sesiones" aria-labelledby="sesiones-titulo">
  <div class="container sesiones-rejilla">
    <div class="sesiones-visual" data-revelar>
      <Image
        src={ilustracion}
        alt="Ilustración: una alumna y su instructor conectados por videoconferencia"
        widths={[360, 560, 760]}
        sizes="(min-width: 1024px) 560px, 92vw"
        class="sesiones-img"
      />
    </div>

    <div class="sesiones-texto">
      <div class="titulo-seccion titulo-seccion--izq" data-revelar>
        <span class="antetitulo">{sesiones.antetitulo}</span>
        <h2 id="sesiones-titulo">{sesiones.titulo}</h2>
      </div>

      <ul role="list" class="puntos" data-revelar-grupo>
        {sesiones.puntos.map((p) => (
          <li class="punto">
            <span class="punto-icono"><Icono nombre={p.icono} tam={26} /></span>
            <span class="punto-texto">
              {p.cifra === undefined ? (
                p.texto
              ) : p.anio ? (
                <>{p.texto} <strong class="cifra" data-contador={p.cifra} data-desde={p.desde} data-anio>{fmt(p.cifra, true)}</strong></>
              ) : (
                <>{p.prefijo} <strong class="cifra" data-contador={p.cifra} data-desde={p.desde}>{fmt(p.cifra)}</strong> {p.texto}</>
              )}
            </span>
          </li>
        ))}
      </ul>

      <a class="enlace-mecenazgo" href={url('mecenazgo/')} data-revelar>
        <span class="punto-icono punto-icono--lila"><Icono nombre="corazon" tam={22} /></span>
        <span>{sesiones.mecenazgo}</span>
        <Icono nombre="flechaDer" tam={18} clase="enlace-flecha" />
      </a>

      <p class="sesiones-cierre" data-revelar>
        <Icono nombre="globo" tam={22} />
        {sesiones.cierre}
      </p>

      <div class="acciones" data-revelar>
        <a href={url('consultame/#solicita')} class="btn btn--primario btn--grande" data-abrir-sesiones>Empieza ahora</a>
        <a href="#como-es" class="btn btn--suave btn--grande">+ Info</a>
      </div>
    </div>
  </div>
</section>

<style>
  .sesiones { background: var(--niebla); }
  .sesiones-rejilla { display: grid; gap: var(--s-7); align-items: center; }
  .sesiones-visual {
    position: relative;
    border-radius: var(--r-lg);
    background: radial-gradient(70% 70% at 50% 45%, var(--blanco) 0%, var(--cielo) 100%);
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }
  :global(.sesiones-img) { width: 100%; height: auto; }


  .puntos { display: grid; gap: var(--s-3); }
  .punto {
    display: flex; align-items: center; gap: var(--s-4);
    padding: var(--s-3) var(--s-4) var(--s-3) var(--s-3);
    background: var(--blanco);
    border-radius: var(--r-md);
    box-shadow: var(--sombra-1);
    font-size: var(--fs-md);
    font-weight: 600;
    line-height: 1.3;
  }
  .punto-texto::first-letter { text-transform: uppercase; }
  .cifra { font-weight: 800; color: var(--turquesa-texto); font-variant-numeric: tabular-nums; }
  .punto-icono {
    flex: none;
    display: grid; place-items: center;
    width: 48px; height: 48px;
    border-radius: 50%;
    background: var(--turquesa-velo);
    color: var(--turquesa-texto);
  }
  .punto-icono--lila { width: 42px; height: 42px; background: color-mix(in srgb, var(--lila) 22%, white); color: #6b4a85; }

  .enlace-mecenazgo {
    display: flex; align-items: center; gap: var(--s-3);
    margin-top: var(--s-5);
    padding: var(--s-2) var(--s-4) var(--s-2) var(--s-2);
    border: 1px dashed color-mix(in srgb, var(--lila) 70%, white);
    border-radius: var(--r-pill);
    color: var(--tinta);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--t-media) var(--ease-suave), border-color var(--t-media) var(--ease-suave);
  }
  .enlace-mecenazgo span:nth-child(2)::first-letter { text-transform: uppercase; }
  .enlace-mecenazgo:hover { background: var(--blanco); border-color: var(--lila); }
  .enlace-mecenazgo :global(.enlace-flecha) { margin-left: auto; color: var(--gris-texto); transition: transform var(--t-media) var(--ease-suave); }
  .enlace-mecenazgo:hover :global(.enlace-flecha) { transform: translateX(3px); }

  .sesiones-cierre {
    display: flex; align-items: center; gap: var(--s-2);
    margin-top: var(--s-6);
    font-size: var(--fs-lg);
    font-weight: 800;
    color: var(--turquesa-texto);
  }
  .acciones { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-5); }

  @media (min-width: 640px) {
    .puntos { grid-template-columns: 1fr 1fr; }
    .punto { flex-direction: column; align-items: flex-start; gap: var(--s-3); padding: var(--s-4) var(--s-5) var(--s-5); }
  }
  @media (min-width: 1024px) {
    .sesiones-rejilla { grid-template-columns: 0.95fr 1.05fr; gap: var(--s-8); }
  }
</style>
