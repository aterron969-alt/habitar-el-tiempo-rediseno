---
// Sello original de la escuela. Encima, recreados en SVG, solo el círculo
// turquesa y la «t», para poder dibujar la «t» con un trazo al cargar.
// Sin JS o con reduce-motion la «t» aparece entera.
import { Image } from 'astro:assets';
import sello from '../assets/orig/logo-EMHT.webp';

interface Props { tam?: number; animar?: boolean; clase?: string }
const { tam = 56, animar = false, clase = '' } = Astro.props;
---
<span class:list={['logo', clase, { 'logo--animado': animar }]} style={`--tam:${tam}px`}>
  <Image src={sello} alt="" width={tam} densities={[1, 2, 3]} loading="eager" class="logo-sello" />
  <svg class="logo-t" viewBox="-100 -100 200 200" aria-hidden="true" focusable="false">
    <circle r="100" fill="var(--turquesa)" />
    <path class="logo-t-trazo" pathLength="1" d="M-3 -64 V40 Q-3 64 22 64 M-26 -34 H25" />
  </svg>
</span>

<style>
  .logo {
    position: relative;
    display: block;
    width: var(--tam);
    aspect-ratio: 285 / 294;
    flex: none;
  }
  .logo-sello { width: 100%; height: 100%; }
  /* El disco turquesa del sello ocupa el 56 % del ancho y está centrado en (51 %, 50,9 %) */
  .logo-t {
    position: absolute;
    width: 57.4%;
    aspect-ratio: 1;
    left: calc(51.05% - 28.7%);
    top: calc(50.85% - 27.84%);
    overflow: visible;
  }
  .logo-t-trazo {
    fill: none;
    stroke: #fff;
    stroke-width: 9;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  :global(html.js) .logo--animado .logo-t-trazo {
    animation: trazo-t 1.2s var(--ease-respira) 0.25s both;
  }
  @keyframes trazo-t {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .logo--animado .logo-t-trazo { animation: none; }
  }
</style>
