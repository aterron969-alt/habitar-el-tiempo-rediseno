---
import { Image } from 'astro:assets';
import type { Testimonio } from '../data/testimonios';
import { imagen } from '../lib/imagenes';

interface Props { t: Testimonio; clase?: string }
const { t, clase } = Astro.props;
const pie = [t.cargo, t.empresa].filter(Boolean).join(' · ');
---
<figure class:list={['testimonio', clase]}>
  <blockquote class="testimonio-texto"><p>{t.texto}</p></blockquote>
  <figcaption class="testimonio-pie">
    {t.foto && (
      <Image src={imagen(t.foto)} alt={`Foto de ${t.nombre}`} width={56} height={56} densities={[1, 2]} class="testimonio-foto" />
    )}
    <span>
      <span class="testimonio-nombre">{t.nombre}</span>
      {pie && <span class="testimonio-cargo">{pie}</span>}
    </span>
  </figcaption>
</figure>

<style>
  .testimonio {
    display: flex; flex-direction: column; gap: var(--s-5);
    height: 100%;
    padding: var(--s-7) var(--s-5) var(--s-5);
    border-radius: var(--r-lg);
    background: var(--blanco);
    box-shadow: var(--sombra-caja);
    transition: transform var(--t-media) var(--ease-suave), box-shadow var(--t-media) var(--ease-suave);
  }
  .testimonio:hover { transform: translateY(-4px); }
  .testimonio-texto { flex: 1; position: relative; }
  .testimonio-texto::before {
    content: '“';
    position: absolute; top: -0.5em; left: -0.05em;
    font-size: 3.5rem; line-height: 1; font-weight: 800;
    color: var(--turquesa);
    opacity: 0.35;
  }
  .testimonio-texto p { color: #3a3a3e; font-size: var(--fs-base); }
  .testimonio-pie { display: flex; align-items: center; gap: var(--s-3); padding-top: var(--s-4); border-top: 1px solid var(--linea); }
  :global(.testimonio-foto) { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex: none; background: var(--niebla); }
  .testimonio-nombre { display: block; font-weight: 800; line-height: 1.25; }
  .testimonio-cargo { display: block; font-size: var(--fs-sm); color: var(--gris-texto); line-height: 1.35; }
</style>
