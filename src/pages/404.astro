---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import budy from '../assets/orig/budy-sobre-el-mundo.webp';
import { url } from '../lib/url';
---
<Base titulo="Página no encontrada · Habitar el Tiempo" descripcion="Esta página no existe. Vuelve al inicio de la Escuela de Mindfulness Habitar el Tiempo.">
  <section class="no-encontrada">
    <div class="container caja">
      <Image src={budy} alt="Budy medita tranquilo sobre el mundo" widths={[320, 560]} sizes="(min-width: 640px) 420px, 80vw" loading="eager" class="budy-mundo" />
      <h1 class="titulo">Esta página no existe</h1>
      <p class="texto">Respira. Puede que el enlace haya cambiado o que la dirección tenga una errata.</p>
      <a class="btn btn--blanco btn--grande" href={url()}>Volver al inicio</a>
    </div>
  </section>
</Base>

<style>
  .no-encontrada {
    min-height: 88svh;
    display: grid; align-items: center;
    padding: calc(var(--cabecera) + var(--s-6)) 0 var(--s-8);
    background: linear-gradient(180deg, #006d76 0%, #007882 100%);
    color: var(--blanco);
  }
  .no-encontrada :focus-visible { outline-color: var(--blanco); }
  .caja { display: grid; justify-items: center; text-align: center; gap: var(--s-4); }
  :global(.budy-mundo) { width: min(400px, 78vw); height: auto; filter: drop-shadow(0 26px 34px rgb(0 40 50 / 0.35)); }
  .titulo { font-size: clamp(2.3rem, 1.4rem + 3.8vw, 4.4rem); font-weight: 800; letter-spacing: -0.03em; }
  .texto { max-width: 40ch; font-size: var(--fs-md); }
  .btn { margin-top: var(--s-3); }
</style>
